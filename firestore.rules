rules_version = '2';

// Règles de sécurité EduShare.
// Les compteurs (commentCount, reactions, stats) et les notifications sont
// écrits uniquement par les Cloud Functions (SDK Admin, non soumis aux règles).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && me().role == 'admin'; }
    function incoming() { return request.resource.data; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // ---------- Utilisateurs ----------
    match /users/{uid} {
      allow read: if signedIn();

      // Inscription : seuls les rôles étudiant et enseignant sont auto-attribuables.
      allow create: if isSelf(uid)
        && incoming().keys().hasOnly(['displayName', 'email', 'role', 'bio', 'university', 'fieldOfStudy', 'createdAt'])
        && incoming().role in ['student', 'teacher']
        && isText(incoming().displayName, 2, 80)
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time;

      // Un utilisateur modifie son profil, jamais son rôle ni ses statistiques.
      // Un administrateur peut tout modifier (attribution des rôles).
      allow update: if (isSelf(uid)
          && changedKeys().hasOnly(['displayName', 'bio', 'university', 'fieldOfStudy'])
          && isText(incoming().displayName, 2, 80)
          && isText(incoming().bio, 0, 500))
        || isAdmin();

      allow delete: if isAdmin();

      // Jetons FCM : privés.
      match /tokens/{token} {
        allow read, write: if isSelf(uid);
      }

      // Notifications in-app : créées par les Cloud Functions.
      match /notifications/{notificationId} {
        allow read, delete: if isSelf(uid);
        allow update: if isSelf(uid) && changedKeys().hasOnly(['read']);
      }
    }

    // ---------- Publications ----------
    function validArticle() {
      return isText(incoming().title, 3, 200)
        && isText(incoming().content, 1, 50000)
        && incoming().category in ['article', 'research', 'courseSummary', 'resource']
        && incoming().tags is list && incoming().tags.size() <= 10
        && isText(incoming().attachmentUrl, 0, 500);
    }

    match /articles/{articleId} {
      allow read: if signedIn();

      allow create: if signedIn() && validArticle()
        && incoming().keys().hasOnly(['title', 'content', 'category', 'tags', 'attachmentUrl',
            'authorId', 'authorName', 'authorRole', 'commentCount', 'reactions', 'createdAt', 'updatedAt'])
        && incoming().authorId == request.auth.uid
        && incoming().authorRole == me().role
        && incoming().commentCount == 0
        && incoming().reactions == {}
        && incoming().createdAt == request.time;

      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && validArticle()
        && changedKeys().hasOnly(['title', 'content', 'category', 'tags', 'attachmentUrl', 'updatedAt']);

      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && incoming().keys().hasOnly(['authorId', 'authorName', 'authorRole', 'text', 'createdAt'])
          && incoming().authorId == request.auth.uid
          && incoming().authorRole == me().role
          && isText(incoming().text, 1, 2000)
          && incoming().createdAt == request.time;
        // Suppression : auteur du commentaire, auteur de la publication ou administrateur.
        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid
          || get(/databases/$(database)/documents/articles/$(articleId)).data.authorId == request.auth.uid
          || isAdmin());
      }

      // Une réaction par utilisateur : le document porte l'uid.
      match /reactions/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && incoming().keys().hasOnly(['type', 'createdAt'])
          && incoming().type in ['like', 'useful', 'bravo'];
        allow delete: if isSelf(uid);
      }
    }

    // ---------- Messagerie ----------
    // Identifiant de conversation = les deux uid triés, séparés par « _ ».
    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in conversationId.split('_');
      }

      allow get: if isParticipant();
      allow list: if signedIn() && request.auth.uid in resource.data.participants;

      allow create: if isParticipant()
        && conversationId.split('_').size() == 2
        && incoming().participants == conversationId.split('_')
        && incoming().keys().hasOnly(['participants', 'names', 'lastMessage', 'lastSenderId', 'lastMessageAt', 'readBy']);

      allow update: if isParticipant()
        && changedKeys().hasOnly(['lastMessage', 'lastSenderId', 'lastMessageAt', 'readBy']);

      match /messages/{messageId} {
        allow read: if isParticipant();
        allow create: if isParticipant()
          && incoming().keys().hasOnly(['senderId', 'text', 'createdAt'])
          && incoming().senderId == request.auth.uid
          && isText(incoming().text, 1, 4000);
      }
    }

    // ---------- Partenaires ----------
    match /partners/{partnerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && incoming().authorId == request.auth.uid
        && (isAdmin() || (me().role == 'partner' && me().partnerId == incoming().partnerId))
        && incoming().type in ['announcement', 'event', 'opportunity']
        && isText(incoming().title, 3, 200)
        && isText(incoming().description, 1, 5000);
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}
